# gradient-project-root/.env.example
# Copy to .env (project root) and uncomment what you need. Environment variables
# override config/default_settings.yaml and config/config.yaml.

# --- Server ---
# GRADIENT_APP_HOST=0.0.0.0
# GRADIENT_APP_PORT=8080
# GRADIENT_APP_RELOAD=true                         # auto-reload on code changes (development)

# --- Models & data ---
# GRADIENT_MODEL_DIR=/path/to/your/models          # extra model folder, searched first and used for new downloads
# GRADIENT_DATA_DIR=/path/to/persistent/data       # database etc.
# GRADIENT_OUTPUTS_DIR=/path/to/experiments        # generated images
# GRADIENT_MEMORY_MODE=auto                        # auto | gpu | balanced | low | minimal
# GRADIENT_DEVICE=cuda:1                           # force a device

# --- Model downloads ---
# HF_TOKEN=hf_xxx                                  # Hugging Face token for gated models (FLUX.1, SD 3.5, ...)
# CIVITAI_TOKEN=xxx                                # Civitai API token for direct-URL downloads
