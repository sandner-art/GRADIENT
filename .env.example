# gradient-project-root/.env.example

# Example Environment Variables for GRADIENT

# --- Application Settings ---
# These can override settings in config/default_settings.yaml and config/config.yaml
# GRADIENT_APP_HOST=0.0.0.0
# GRADIENT_APP_PORT=8080

# --- Paths (Optional - App might use config files primarily) ---
# GRADIENT_MODEL_DIR=/path/to/your/models
# GRADIENT_DATA_DIR=/path/to/persistent/data

# --- API Keys (If needed later for external services) ---
# EXTERNAL_API_KEY=your_api_key_here

# --- Development Flags ---
# GRADIENT_APP_RELOAD=true # Enable auto-reload (alternative to config file)